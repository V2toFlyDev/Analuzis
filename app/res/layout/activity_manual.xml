<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:text="‹  Volver"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Oferta a mano"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="Escribe los precios que publica su web, sin impuestos. El resto de la factura se toma de la tuya."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- 1. La oferta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LA OFERTA" />

            <EditText
                android:id="@+id/inName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre de la oferta"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inSupplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Comercializadora"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Web de la oferta"
                android:inputType="textUri"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Abrir su web ›"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. Precios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRECIOS SIN IMPUESTOS" />

            <EditText
                android:id="@+id/inEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Energía (€/kWh)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swTramos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Por tramos P1/P2/P3"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/boxTramos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/inE1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Energía P1 · punta (€/kWh)"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/inE2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Energía P2 · llano (€/kWh)"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/inE3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Energía P3 · valle (€/kWh)"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/inP1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Potencia P1 (€/kW·día)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inP2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Potencia P2 (€/kW·día)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="La potencia va en €/kW·día. Si su web la da en €/kW·año, divídela entre 365 (por ejemplo, 33 €/kW·año son 0,0904 €/kW·día). Si solo hay un precio, déjalo en P1 y se usa para las dos."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/fichaNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Excedentes y condiciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXCEDENTES Y CONDICIONES" />

            <CheckBox
                android:id="@+id/cbCompensates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/accent"
                android:text="Compensa excedentes"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inSurplus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Lo que paga por tus excedentes (€/kWh)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="@color/accent"
                android:text="Batería virtual"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="Energía verde"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbPenalty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="Con permanencia"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="La batería virtual queda como nota: no cambia el cálculo, porque su saldo y su caducidad no vienen en ninguna ficha."
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Resultado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CON TUS DATOS" />

            <LinearLayout
                android:id="@+id/resultBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="El bono social, el alquiler del contador y los impuestos no son de la oferta: se copian de tu última factura. Sin factura no hay con qué comparar, así que no se guarda."
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Guardar oferta" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="12dp"
            android:text="Borrar esta oferta"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
